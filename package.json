  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
